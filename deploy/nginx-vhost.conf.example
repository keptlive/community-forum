# Community Forum nginx vhost (example)

server {
    listen 80;
    access_log off;
    server_name forum.example.org;

    location /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name forum.example.org;
    client_max_body_size 50M;
    access_log off;

    ssl_certificate /etc/letsencrypt/live/forum.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/forum.example.org/privkey.pem;

    location /fonts/ {
        root /var/www/polis;
        expires 30d;
    }

    # Notifications: the service worker (checked for updates on every visit),
    # the Home Screen app's manifest, and their icons.
    location = /sw.js {
        root /var/www/polis;
        types { } default_type application/javascript;
        add_header Cache-Control "no-cache";
    }

    location = /manifest.webmanifest {
        root /var/www/polis;
        types { } default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    location ~ ^/(icon-192|icon-512|apple-touch-icon|badge-96)\.png$ {
        root /var/www/polis;
        expires 7d;
    }

    location = /privacy {
        root /var/www/polis;
        try_files /privacy.html =404;
    }

    location = /tos {
        root /var/www/polis;
        try_files /tos.html =404;
    }

    # Custom landing page at exact root
    location = / {
        root /var/www/polis;
        try_files /landing.html =404;
        add_header Cache-Control "no-cache";
    }

    # Conversation IDs (start with a digit) go to the alpha participation client
    location ~ ^/([0-9][0-9A-Za-z]+)$ {
        return 301 /alpha/$1;
    }

    # Root-level readable topic URLs: the hub serves known slugs via
    # X-Accel-Redirect (/_conv/) and passes unknown single-segment names
    # through to Polis (/_polis/) so /home, /signin, etc. keep working.
    location ~ "^/[a-z0-9-]+$" {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:9876;
        proxy_set_header Host $host;
        proxy_set_header X-External-Request 1;
    }

    location = /conversations { deny all; }

    location = /_topic {
        internal;
        alias /var/www/polis/landing.html;
        default_type text/html;
        add_header Cache-Control "no-cache";
    }

    location /p/ {
        proxy_pass http://127.0.0.1:9876;
        proxy_set_header Host $host;
        proxy_set_header X-External-Request 1;
    }

    location /_polis/ {
        internal;
        rewrite ^/_polis/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
        proxy_buffering off;
    }

    location /_astro/ {
        proxy_pass http://127.0.0.1:4321;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
        proxy_buffering off;
    }

    location /alpha/ {
        rewrite ^/alpha/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:4321;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
        proxy_buffering off;
    }

    # Public topic hub API — the ONLY part of the local proxy (127.0.0.1:9876)
    # exposed to the internet: list topics, create a topic, close your own.
    # The /wa/* and admin routes on that port stay loopback-only.
    # Human-readable topic URLs: the hub resolves the slug and answers with
    # X-Accel-Redirect to /_conv/<id>, so the browser keeps the slug URL.
    location /t/ {
        proxy_pass http://127.0.0.1:9876;
        proxy_set_header Host $host;
        proxy_set_header X-External-Request 1;
    }

    location /_conv/ {
        internal;
        rewrite ^/_conv/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:4321;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
        proxy_buffering off;
    }

    location /public/ {
        limit_req zone=polis_public burst=15 nodelay;
        proxy_pass http://127.0.0.1:9876;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Host $host;
        proxy_set_header X-External-Request 1;
    }

    # Everything else (API, admin, report) to the polis server
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300;
        proxy_buffering off;
    }
}

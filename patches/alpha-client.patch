+
+  try {
+    localStorage.setItem('ccf-account', JSON.stringify({
+      accountId: acct.accountId,
+      name: acct.name || '',
+      channel: 'email',
+      contact: email
+    }))
+  } catch {
+    // localStorage unavailable (private mode) — subscription still succeeded
+  }
+  return sub
